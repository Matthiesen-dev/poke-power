{
  "multipart": [
    {
      "apply": { "model": "poke_power:block/power_cable_core" }
    },
    {
      "when": { "OR": [ { "north": "cable" }, { "north": "machine" } ] },
      "apply": { "model": "poke_power:block/power_cable_arm" }
    },
    {
      "when": { "north": "cable" },
      "apply": { "model": "poke_power:block/power_cable_connector" }
    },
    {
      "when": { "north": "machine" },
      "apply": { "model": "poke_power:block/power_cable_machine_connector" }
    },
    {
      "when": { "OR": [ { "south": "cable" }, { "south": "machine" } ] },
      "apply": { "model": "poke_power:block/power_cable_arm", "y": 180 }
    },
    {
      "when": { "south": "cable" },
      "apply": { "model": "poke_power:block/power_cable_connector", "y": 180 }
    },
    {
      "when": { "south": "machine" },
      "apply": { "model": "poke_power:block/power_cable_machine_connector", "y": 180 }
    },
    {
      "when": { "OR": [ { "west": "cable" }, { "west": "machine" } ] },
      "apply": { "model": "poke_power:block/power_cable_arm", "y": 270 }
    },
    {
      "when": { "west": "cable" },
      "apply": { "model": "poke_power:block/power_cable_connector", "y": 270 }
    },
    {
      "when": { "west": "machine" },
      "apply": { "model": "poke_power:block/power_cable_machine_connector", "y": 270 }
    },
    {
      "when": { "OR": [ { "east": "cable" }, { "east": "machine" } ] },
      "apply": { "model": "poke_power:block/power_cable_arm", "y": 90 }
    },
    {
      "when": { "east": "cable" },
      "apply": { "model": "poke_power:block/power_cable_connector", "y": 90 }
    },
    {
      "when": { "east": "machine" },
      "apply": { "model": "poke_power:block/power_cable_machine_connector", "y": 90 }
    },
    {
      "when": { "OR": [ { "up": "cable" }, { "up": "machine" } ] },
      "apply": { "model": "poke_power:block/power_cable_arm", "x": 270 }
    },
    {
      "when": { "up": "cable" },
      "apply": { "model": "poke_power:block/power_cable_connector", "x": 270 }
    },
    {
      "when": { "up": "machine" },
      "apply": { "model": "poke_power:block/power_cable_machine_connector", "x": 270 }
    },
    {
      "when": { "OR": [ { "down": "cable" }, { "down": "machine" } ] },
      "apply": { "model": "poke_power:block/power_cable_arm", "x": 90 }
    },
    {
      "when": { "down": "cable" },
      "apply": { "model": "poke_power:block/power_cable_connector", "x": 90 }
    },
    {
      "when": { "down": "machine" },
      "apply": { "model": "poke_power:block/power_cable_machine_connector", "x": 90 }
    }
  ]
}